# Copy to .env, fill in, keep it out of git (chmod 600).
#
# The token must be the PER-SERVER token for the library you want to serve,
# not your Plex account token. An account token reaches every server that is
# shared with you, and anything done with it looks like you to all of them.

PLEX_BASE_URL=https://plex.example.com
PLEX_TOKEN=

# Optional: expose only these library titles, comma separated.
#PLEX_SECTIONS=Movies,Movies - 4K,TV Shows

# Per-server tuning. Measure before changing; see README.
PLEX_STREAMS=4
PLEX_CHUNK_MIB=32
#PLEX_HTTP2=1

# A second server, and a third, and so on. The first one to hold a title wins.
#PLEX2_BASE_URL=https://other.example.com
#PLEX2_TOKEN=
#PLEX2_NAME=backup
#PLEX2_STREAMS=8
#PLEX2_HTTP2=1
# Serve exactly the first server's tree; the others only stand in when it is down.
#PLEX_MIRROR_PRIMARY=1

# Without these the endpoint is unauthenticated and anyone who can reach it
# reads the whole library.
WEBDAV_USER=plex
WEBDAV_PASS=change-me

LISTEN_ADDR=:8080
CACHE_TTL=24h
REFRESH_INTERVAL=5m

# Optional: let the bridge invalidate the rclone mount's directory cache
# and ask a local Plex to rescan only the directories that changed.
#RCLONE_RC_URL=http://127.0.0.1:5572
#PLEX_LOCAL_URL=http://127.0.0.1:32400
#PLEX_LOCAL_TOKEN=
